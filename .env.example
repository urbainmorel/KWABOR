# Reference inventory only: Gradle, Xcode and GitHub Actions do not load this
# file automatically. Use local.properties.example for Android and
# iosApp/Kwabor/Config/Local.xcconfig.example for iOS local builds.
KWABOR_ENVIRONMENT=development

# Generic client values are read only by the matching KWABOR_ENVIRONMENT.
KWABOR_SUPABASE_URL=
KWABOR_SUPABASE_PUBLISHABLE_KEY=
KWABOR_GOOGLE_WEB_CLIENT_ID=
KWABOR_GOOGLE_IOS_CLIENT_ID=
KWABOR_GOOGLE_SERVER_CLIENT_ID=
KWABOR_GOOGLE_REVERSED_CLIENT_ID=
KWABOR_FIREBASE_PROJECT_ID=

# Staging authority and guarded Supabase operations. The database URL must be
# the TLS session-pooler URI on port 5432, never the direct IPv6 endpoint.
KWABOR_SUPABASE_PROJECT_REF=
KWABOR_PRODUCTION_SUPABASE_PROJECT_REF=
KWABOR_STAGING_PROJECT_REF_SHA256=
KWABOR_DEMO_MEDIA_BASE_URL=
KWABOR_SUPABASE_SERVICE_ROLE_KEY=
KWABOR_STAGING_DATABASE_URL=
SUPABASE_ACCESS_TOKEN=

# Hosted Auth staging. Client secrets and SMTP credentials belong only in the
# protected staging Environment; keep this inventory empty.
KWABOR_GOOGLE_WEB_CLIENT_SECRET=
KWABOR_AUTH_SMTP_ADMIN_EMAIL=
KWABOR_AUTH_SMTP_HOST=
KWABOR_AUTH_SMTP_PORT=
KWABOR_AUTH_SMTP_USER=
KWABOR_AUTH_SMTP_PASSWORD=

# Optional Android per-tier values let local validation build several variants safely.
KWABOR_SUPABASE_URL_DEVELOPMENT=
KWABOR_SUPABASE_PUBLISHABLE_KEY_DEVELOPMENT=
KWABOR_GOOGLE_WEB_CLIENT_ID_DEVELOPMENT=
KWABOR_SUPABASE_URL_STAGING=
KWABOR_SUPABASE_PUBLISHABLE_KEY_STAGING=
KWABOR_GOOGLE_WEB_CLIENT_ID_STAGING=
KWABOR_SUPABASE_URL_PRODUCTION=
KWABOR_SUPABASE_PUBLISHABLE_KEY_PRODUCTION=
KWABOR_GOOGLE_WEB_CLIENT_ID_PRODUCTION=

KWABOR_VERSION_CODE=1
KWABOR_VERSION_NAME=0.1.0

# Production Android signing. The Base64 payload belongs only in the protected
# GitHub Environment; local builds use the unversioned keystore path instead.
KWABOR_ANDROID_KEYSTORE_BASE64=
KWABOR_ANDROID_KEYSTORE_PATH=
KWABOR_ANDROID_KEYSTORE_PASSWORD=
KWABOR_ANDROID_KEY_ALIAS=
KWABOR_ANDROID_KEY_PASSWORD=
KWABOR_ANDROID_UPLOAD_CERT_SHA256=
KWABOR_STAGING_FIREBASE_PROJECT_ID_SHA256=

# Play Internal values belong to the protected play-internal Environment.
KWABOR_PLAY_PACKAGE_NAME=
KWABOR_PLAY_SERVICE_ACCOUNT_JSON_BASE64=

# iOS distribution values belong to the selected GitHub Environment.
KWABOR_IOS_DEVELOPMENT_TEAM=
KWABOR_IOS_BUNDLE_ID=
KWABOR_IOS_PROVISIONING_PROFILE_NAME=
KWABOR_IOS_USES_NON_EXEMPT_ENCRYPTION=
KWABOR_IOS_DISTRIBUTION_CERTIFICATE_BASE64=
KWABOR_IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=
KWABOR_IOS_PROVISIONING_PROFILE_BASE64=

# App Store Connect/TestFlight Internal values belong only in the protected
# testflight-internal Environment.
KWABOR_ASC_KEY_ID=
KWABOR_ASC_ISSUER_ID=
KWABOR_ASC_APP_ID=
KWABOR_TESTFLIGHT_INTERNAL_GROUP_ID=
KWABOR_ASC_PRIVATE_KEY_BASE64=

# Provider files are injected by release workflows and always stay unversioned.
KWABOR_FIREBASE_ANDROID_CONFIG_BASE64=
KWABOR_FIREBASE_IOS_CONFIG_BASE64=

# B6.02 encrypted backup. The private identity must also have a tested
# two-person recovery copy outside GitHub and outside this repository.
KWABOR_STAGING_BACKUP_AGE_RECIPIENT=
KWABOR_STAGING_BACKUP_AGE_IDENTITY=
KWABOR_STAGING_BACKUP_ESCROW_MODE=
KWABOR_STAGING_BACKUP_ESCROW_RECIPIENT_SHA256=
KWABOR_STAGING_BACKUP_ESCROW_TESTED_AT=
KWABOR_STAGING_BACKUP_ESCROW_VALID_UNTIL=
KWABOR_STAGING_BACKUP_MAX_RPO_SECONDS=
KWABOR_STAGING_BACKUP_MAX_RTO_SECONDS=
KWABOR_STAGING_BACKUP_RETENTION_DAYS=
KWABOR_STAGING_BACKUP_LIVE_ENABLED=
